#!/usr/bin/env gnuplot

set xtics
set ytics
set mxtics
set mytics
set grid xtics ytics mxtics mytics
set key bottom left Left reverse maxcols 1
set linetype 1 lc 7 lw 2.5
set linetype 2 lc black dt 2

TC(TK) = TK - 273.15
rho = 1200
refcase = '../reference/moments.dat'

set terminal pdfcairo enhanced size 7,5 lw 2
set output 'postProcessing-all.pdf'
set multiplot layout 2,3

set xlabel 'Time, s'
set ylabel 'Concentration, kg/m^3'
p \
'../postProcessing/probes/0/C' u 1:2 w l ti 'OpenFOAM', \
refcase u 't':'C' w l dt 2 ti 'Reference'

unset key
set ylabel 'Temperature, ℃'
p \
'../postProcessing/probes/0/T' u 1:(TC($2)) w l ti 'OpenFOAM', \
refcase u 't':(TC(column('T'))) w l dt 2 ti 'Reference'

set ylabel 'Moment M_0, m^{-3}'
p \
'../postProcessing/probes/0/moment.0.populationBalance' u 1:2 w l ti 'OpenFOAM', \
refcase u 't':'M0' w l dt 2 ti 'Reference'

set ylabel 'Moment M_1, m^{-2}'
p \
'../postProcessing/probes/0/moment.1.populationBalance' u 1:2 w l ti 'OpenFOAM', \
refcase u 't':'M1' w l dt 2 ti 'Reference'

set ylabel 'Moment M_2, m^{-1}'
p \
'../postProcessing/probes/0/moment.2.populationBalance' u 1:2 w l ti 'OpenFOAM', \
refcase u 't':'M2' w l dt 2 ti 'Reference'

set ylabel 'Moment M_3, -'
p \
'../postProcessing/probes/0/moment.3.populationBalance' u 1:2 w l ti 'OpenFOAM', \
refcase u 't':'M3' w l dt 2 ti 'Reference'

unset multiplot
